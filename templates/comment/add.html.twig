{% extends 'base.html.twig' %}

{% block title %}
    Ajouter un commentaire
{% endblock %}

{% block body %}
    <h1>Ajouter un commentaire pour {{ restaurant.nom }}</h1>
    {{ form_start(form) }}
    {{ form_widget(form) }}
    <button type="submit">Enregistrer</button>
    {{ form_end(form) }}
    <a href="{{ path('restaurant_show', {id: restaurant.id}) }}">Annuler</a>
{% endblock %}
